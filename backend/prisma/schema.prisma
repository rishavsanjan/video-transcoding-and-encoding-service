generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Video {
  id           String        @id @default(uuid())
  originalName String
  originalPath String
  status       VideoStatus   @default(UPLOADED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  encodingJobs EncodingJob[]
}

model EncodingJob {
  id         String         @id @default(uuid())
  videoId    String
  resolution Int
  status     EncodingStatus @default(QUEUED)
  outputPath String?
  error      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  video      Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  progress   Int            @default(0)

  @@index([videoId])
}

enum VideoStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum EncodingStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}
